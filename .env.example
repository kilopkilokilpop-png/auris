# AURIS — copy to .env and fill in. Every key is optional for `pnpm dev`:
# without keys the app runs on the local demo catalogue (MockProvider) and mock recognition.
# Secrets live ONLY here (server side). Nothing below is sent to the Mini App bundle.

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3001
# Public HTTPS origin of the API, used in stream URLs. Leave empty when the Mini App proxies /api (dev, single domain).
PUBLIC_API_URL=
# HTTPS URL of the Mini App. Also the only origin allowed by CORS.
MINI_APP_URL=http://localhost:5173

# ---------- Database ----------
# PostgreSQL / Supabase connection string. Empty = embedded PGlite in DATA_DIR (development only).
DATABASE_URL=
DATA_DIR=.data

# ---------- Telegram ----------
# Token from @BotFather. Empty = bot disabled; Mini App works in a normal browser with a signed dev user.
BOT_TOKEN=
# Bot username without @ (used for "start the bot" links)
BOT_USERNAME=
BOT_PORT=3002
# webhook (production) | polling (local only)
BOT_MODE=webhook
# Public HTTPS base of the bot server; the webhook is <BOT_WEBHOOK_URL>/telegram/webhook
BOT_WEBHOOK_URL=
# Secret checked on every webhook call (X-Telegram-Bot-Api-Secret-Token). 1–256 chars: A-Z a-z 0-9 _ -
WEBHOOK_SECRET=
# Shared secret for bot -> API internal calls (generate: openssl rand -hex 32)
INTERNAL_API_SECRET=
INTERNAL_API_URL=http://127.0.0.1:3001
# All-in-one deploy (apps/server): only local connections may call /internal/*
INTERNAL_LOOPBACK_ONLY=false
# Max age of Telegram initData, seconds
INIT_DATA_MAX_AGE_SEC=86400
# Signs short-lived audio stream URLs (generate: openssl rand -hex 32). Required in production.
STREAM_SIGNING_SECRET=
# Development only: browser login with a signed fake user. Forced off when NODE_ENV=production.
ALLOW_DEV_AUTH=true

# ---------- Music providers ----------
# Comma list in priority order: mock, deezer, jamendo, licensed
MUSIC_PROVIDERS=mock
# Deezer API terms: non-commercial use only, 30-second previews, no downloads. Set true to confirm you comply.
DEEZER_ENABLED_NONCOMMERCIAL=false
# https://devportal.jamendo.com — free for non-commercial use. Commercial use needs a Jamendo licence.
JAMENDO_CLIENT_ID=
# Jamendo terms limit caching to what is necessary -> keep false unless your licence allows file_id reuse.
JAMENDO_CACHE_FILE_ID=false
# Future B2B catalogue (Tuned Global, 7digital, ...), see docs/licensed-provider.md
LICENSED_API_URL=
LICENSED_API_KEY=
# true ONLY after the contract explicitly grants download + sending files to users
LICENSED_DOWNLOADS_CONTRACTED=false
LICENSED_CACHE_FILE_ID=false

# ---------- Recognition (Слух) ----------
# none | mock (dev only, fake results) | audd | acrcloud | fallback chain e.g. audd,acrcloud
RECOGNITION_PROVIDERS=mock
AUDD_API_TOKEN=
# e.g. identify-eu-west-1.acrcloud.com
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
FFMPEG_PATH=ffmpeg

# ---------- Limits ----------
RECOGNITION_PER_DAY=30
RECOGNITION_PER_MINUTE=4
DOWNLOADS_PER_DAY=20
DOWNLOAD_CONCURRENCY=2
API_RATE_LIMIT_PER_MINUTE=240

# ---------- Mini App build (public, baked into the bundle) ----------
# API origin if the API is on another domain than the Mini App; empty = same origin (/api)
VITE_API_URL=
VITE_BOT_USERNAME=
