    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "grammy": "1.46.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
