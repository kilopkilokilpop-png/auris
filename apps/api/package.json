{
  "name": "@auris/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "revoke": "tsx src/scripts/revoke.ts"
  },
  "dependencies": {
    "@auris/shared": "workspace:*",
    "@electric-sql/pglite": "0.5.14",
    "@fastify/cors": "11.4.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "grammy": "1.46.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  }
}
