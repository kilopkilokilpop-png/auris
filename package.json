{
  "name": "auris",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && pnpm run test:e2e",
    "test:unit": "pnpm -r run test",
    "test:e2e": "playwright test",
    "screenshots": "playwright test e2e/screens.spec.ts && node scripts/compare-design.mjs",
    "check": "pnpm run check:types && pnpm run check:lint && pnpm run check:env && pnpm run check:migrations",
    "check:types": "pnpm --filter @auris/shared run build && pnpm -r run typecheck",
    "check:lint": "eslint .",
    "check:env": "tsx scripts/check-env.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "db:migrate": "pnpm --filter @auris/api run db:migrate",
    "smoke": "tsx scripts/smoke-providers.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
